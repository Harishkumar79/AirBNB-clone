<% layout("/layouts/boilerplate") -%>
    <div class="row">
        <div class="col-6 offset-3 mt-3">
            <h3 class="text-center">Login To AirBNB</h3>
            <form action="/user/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label name="username" class="form-label">Username :</label>
                    <input class="form-control" name="username" id="username" placeholder="Enter your username"
                        type="text" required />
                </div>
                <div class="mb-3">
                    <label name="password" class="form-label">Password :</label>
                    <input class="form-control" name="password" type="password" required />
                </div>
                <button class="btn btn-success" type="submit">Login</button>
            </form>
        </div>
    </div>