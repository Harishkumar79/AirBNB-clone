<% layout("/layouts/boilerplate") -%>
    <div class="row">
        <div class="col-6 offset-3 mt-3">
            <h3 class="text-center">SignUp To AirBNB</h3>
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label name="username" class="form-label">Username :</label>
                    <input class="form-control" name="username" id="username" placeholder="Enter your username"
                        type="text" required />
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a valid username!
                    </div>
                </div>
                <div class="mb-3">
                    <label name="email" class="form-label">Email :</label>
                    <input class="form-control" name="email" placeholder="Enter your email" type="email" required />
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a valid email!
                    </div>
                </div>
                <div class="mb-3">
                    <label name="password" class="form-label">Password :</label>
                    <input class="form-control" name="password" type="password" required />
                </div>
                <button class="btn btn-success" type="submit">SignUp</button>
            </form>
        </div>
    </div>