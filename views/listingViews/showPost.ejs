<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="card listing-card" style="width: 100%;">
            <div class="image-grid">
                <div class="row gx-2  h-100">

                    <div class="col-md-8 h-100">
                        <img src="<%= post.image.url %>" class="img-fit" alt="image">
                    </div>

                    <div class="col-md-4 h-100">
                        <div class="row h-100 pb-2">

                            <div class=" h-50 mb-2 ">
                                <img src="<%= post.image.url %>" class="img-fit" alt="image">
                            </div>

                            <div class=" h-50">
                                <img src="<%= post.image.url %>" class="img-fit" alt="image">
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="fs-3 fw-bold">
                        <%= post.title %>
                    </div>
                    <div class="fw-bold">
                       <i>Owned By : <%= post.owner.username %></i>
                    </div>
                    <div class=" fs-4">
                        <%= post.description %>
                    </div>
                    <div class="fw-semibold">&#8377; <%= post.price.toLocaleString("en-IN") %>
                    </div>
                    <div>
                        <%= post.location %>
                    </div>
                    <div>
                        <%= post.country %>
                    </div>
                </div>
                <div class="row">
                    <form class="col-md-6" post="get" action="/listing/<%= post._id  %>/edit">
                        <button class="w-100 btn btn-success mb-3 ">Edit</button>
                    </form>
                    <form class="col-md-6" method="post" action="/listing/<%= post._id%>/?_method=DELETE">
                        <button class="w-100 btn btn-success mb-3 ">Delete</button>
                    </form>
                </div>
            </div>

            <hr />

            <div class="mb-3 col-10 offset-1">
                <form action="/listing/<%= post._id  %>/review" method="post" class="needs-validation" novalidate>
                    <h3>Write a Review</h3>
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" class="form-range" name="review[rating]" min="1" max="5">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" rows="5" class="form-control"
                        placeholder="Please enter your Review here" required></textarea>
                    <div class="invalid-feedback">
                        Please add comment to review!
                    </div>
                    <button class="mt-3 btn btn-success mb-3 " type="submit">Add Review</button>
                </form>

                <hr>

                <div>
                    <p><b>All Reviews!</b></p>
                    <div class="row">
                        <% for(review of post.reviews) { %>
                            <div class="card col-5 mb-3 mx-3">
                                <div class="card-body">
                                    <div class="card-title">HK SEN</div>
                                    <div class="card-text">
                                        <%= review.comment %>
                                    </div>
                                    <div class="card-text">
                                        <%= review.rating %><b><i> star</i></b>
                                    </div>
                                </div>
                                <form class="mb-3 ms-auto" method="post" action="/listing/<%= post._id%>/review/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-success">Delete</button>
                                </form>
                            </div>
                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </body>