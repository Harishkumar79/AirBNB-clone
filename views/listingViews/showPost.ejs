<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="card" style="width: 100%;">
            <div>
                <div class="row gx-2" style="height: 48vh;">

                    <div class="col-md-8 h-100">
                        <img src="<%= post.image.url %>" class="img-fit" alt="image">
                    </div>

                    <div class="col-md-4 h-100">
                        <div class="row h-100 pb-2">

                            <div class="col-12 h-50 mb-2 ">
                                <img src="<%= post.image.url %>" class="img-fit" alt="image">
                            </div>

                            <div class="col-12 h-50">
                                <img src="<%= post.image.url %>" class="img-fit" alt="image">
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class=" fs-3 fw-bold">
                        <%= post.title %>
                    </div>
                    <div class=" fs-4">
                        <%= post.description %>
                    </div>
                    <div class="fw-semibold">&#8377; <%= post.price.toLocaleString("en-IN") %>
                    </div>
                    <div>
                        <%= post.location %>
                    </div>
                    <div>
                        <%= post.country %>
                    </div>
                </div>
                <div class="row">
                    <form class="col-6" post="get" action="/listing/<%= post._id  %>/edit">
                        <button class="w-100 btn btn-success mb-3 ">Edit</button>
                    </form>
                    <form class="col-6" method="post" action="/listing/<%= post._id%>/?_method=DELETE">
                        <button class="w-100 btn btn-success mb-3 ">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </body>